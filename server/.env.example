# Server Configuration
PORT=4000

# Mosquitto Secure MQTT Broker Configuration (Port 8883 MQTTS TLS)
MOSQUITTO_HOST=test.mosquitto.org
MOSQUITTO_PORT=8883
MOSQUITTO_USERNAME=
MOSQUITTO_PASSWORD=

# Option 2: HiveMQ Public Free Broker (Zero Setup, Port 1883)
# MOSQUITTO_HOST=broker.hivemq.com
# MOSQUITTO_PORT=1883

# Option 3: EMQX Cloud Serverless Free Tier (emqx.com/en/cloud - Port 8883 TLS)
# MOSQUITTO_HOST=your-cluster.emqx.cloud
# MOSQUITTO_PORT=8883
# MOSQUITTO_USERNAME=emqx_user
# MOSQUITTO_PASSWORD=emqx_password

# Google Gemini AI Assistant Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

