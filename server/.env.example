# Server Configuration
PORT=4000

# Free MQTT Broker Configuration Options:
# Option 1: HiveMQ Public Free Broker (Zero Setup, No Credentials Required)
HIVEMQ_HOST=broker.hivemq.com
HIVEMQ_PORT=1883
HIVEMQ_USERNAME=
HIVEMQ_PASSWORD=

# Option 2: EMQX Cloud Serverless Free Tier (emqx.com/en/cloud)
# HIVEMQ_HOST=your-cluster.emqx.cloud
# HIVEMQ_PORT=8883
# HIVEMQ_USERNAME=emqx_user
# HIVEMQ_PASSWORD=emqx_password

# Option 3: Mosquitto Public Test Broker
# HIVEMQ_HOST=test.mosquitto.org
# HIVEMQ_PORT=1883
